Seedscript module description language 2.3

Module("KubeVirtExtraMedia") {
  description: "Specifies how the KubeVirt builders (kubevirt-iso and kubevirt-image) attach ADDITIONAL, read-only media to the temporary build VM so provisioners can read large ancillary payloads (for example a ~65MB Cloudbase-Init installer) off a mounted CD-ROM instead of streaming them into the guest over WinRM/SSH (slow) or through a ConfigMap (capped at ~1MB by etcd). It is the KubeVirt/CDI analogue of QEMU's cd_files, adapted to the fact that KubeVirt can only attach disks that already live in the cluster. The plugin's role is deliberately NARROW and guest-agnostic: it takes a reference to media that already exists in the cluster and attaches it read-only; it never bundles files, builds an ISO, streams bytes, or interprets the payload — mirroring the shutdown_command boundary. The AIRGAP-PRIMARY source is an existing CDI DataVolume (data_volume) that was staged out-of-band — the airgap-first pipeline builds the ISO with vdi-factory and pushes it into the cluster with `harvester-image stage-iso` (resumable dd-over-exec), exactly the path already proven for iso_volume_name. Two connected-cluster alternatives exist: container_disk (an OCI containerDisk the container runtime pulls) and url (a cluster-reachable HTTP source CDI imports). WHO builds and stages the payload — reading the media declaration, assembling the ISO, and calling stage-iso — is a vdi-factory + harvester-image-tools concern (see vdi_factory MediaStaging and HarvesterImageStageISO), never the plugin's."
  metaphor: "A pallet delivered to the loading dock. The crate is packed, labeled, and hauled through the airlock elsewhere (vdi-factory + harvester-image-tools); the cluster's crane sets it read-only on the workbench next to the machine being built, and the worker inside reads what they need off it. The builder is only the crane operator — it never packs the crate."
  version: "0.3.0"
  tags: ["packer", "kubevirt", "cdi", "media", "cd_files", "datavolume", "containerdisk", "provisioning", "large-payload", "airgap"]
  theme: {
    visual_style: "loading-dock-and-pallet",
    color_palette: ["#20303A", "#3E5C66", "#6E8894", "#C7B08B"],
    metaphorical_language: "loading dock, palletized crate, read-only shelf, crane lift, reference cart"
  }

  components: {
    Roots {
      Directive("/attach_extra_media") {
        description: "Entry point: resolve each configured extra-media reference into a read-only volume + disk on the temporary build VM, in addition to the boot/root disks. Guest-agnostic — the builder never reads or mounts the media; the guest does. Applies to BOTH kubevirt-iso and kubevirt-image, and does not alter the captured root disk (extra media is build-time scaffolding, never part of the golden image)."
        metaphor: "Wheel the labeled pallet up to the workbench and lock its brakes; the worker decides what to take off it."
        parameters: {
          namespace: { type: "string", description: "Build namespace of the temporary VM.", required: true },
          extra_media: { type: "array", description: "Zero or more read-only media entries; each entry sets exactly one source kind (data_volume | container_disk | url) plus attachment options (as = cdrom|disk, name/serial, bus).", required: false }
        }
        actions: {
          validate: "Reject entries with zero or multiple source kinds, a malformed url, a url missing storage_size, or a disk name colliding with rootdisk/cdrom/oemdrv/sysprep/virtiocontainerdisk. For a data_volume, PREFLIGHT that it is builder-ready before create: content-verified (NOT merely DataVolume phase Succeeded, which for a blank Block DV means only bound, before bytes are written), expected Block/size shape, and RWO-free (no stage tap pod still attached); fail fast otherwise.",
          resolve: "Turn each entry into a KubeVirt volume + disk: reference an existing DataVolume or an OCI containerDisk directly, or (connected clusters) CDI-import a url via the shared staging layer.",
          attach: "Append the resolved read-only volumes and CD-ROM/disk devices to the temporary VM spec.",
          hand_off: "Record which media (if any) were plugin-managed (url-imported) so cleanup releases only those."
        }
        kernel: "ExtraMediaKernel"
        tags: ["entry", "read-only", "guest-agnostic", "both-builders"]
      }

      Directive("/release_extra_media") {
        description: "Reverse-order cleanup. Detachment is implicit when the temporary VM is deleted; this only deletes plugin-managed (url-imported) media per ownership and retain-on-failure policy. Referenced media — an existing DataVolume staged by the pipeline, or an OCI containerDisk — is NEVER deleted by the plugin."
        metaphor: "Return only the crates you had delivered for this job; never touch the pallets the pipeline placed in the yard."
        parameters: {
          namespace: { type: "string", description: "Build namespace.", required: true }
        }
        actions: {
          clean: "Delete plugin-owned url-imported media DataVolumes on success; retain them on failure for reuse; leave referenced data_volume / container_disk media untouched."
        }
        kernel: "ExtraMediaKernel"
        tags: ["cleanup", "ownership-boundary", "reverse-order"]
      }
    }

    Bloom {
      Function("validate_media_source") {
        description: "Validate a single extra-media entry: exactly one of data_volume, container_disk, or url is set; a url is a well-formed http(s) URL with a positive storage_size and optional checksum; the attachment mode is cdrom or disk; and the disk name does not collide with the builder's reserved disks."
        metaphor: "Check the shipping label: one crate per manifest line, addressed correctly, and it will not sit where another crate already stands."
        input_parameters: {
          entry: { type: "object", description: "One extra_media entry (source selectors + attachment options).", required: true },
          reserved_disk_names: { type: "array", description: "Names already used by the builder (rootdisk, cdrom, oemdrv, sysprep, virtiocontainerdisk).", required: true }
        }
        output_format: {
          media_kind: "One of data_volume, container_disk, or url.",
          normalized_entry: "Validated, defaulted attachment options (mode, name, bus)."
        }
        tags: ["pure", "validation", "fail-fast"]
      }

      Function("resolve_reference_media") {
        description: "For a data_volume (existing in-cluster CDI DataVolume/PVC name — the airgap-primary, typically staged by `harvester-image stage-iso`) or a container_disk (OCI image reference the container runtime pulls, as the Windows builds already do for virtio drivers), produce the KubeVirt volume source directly, WITHOUT importing, copying, or taking ownership."
        metaphor: "Point at a pallet already in the yard; the crane lifts it as-is."
        input_parameters: {
          media_kind: { type: "string", description: "data_volume | container_disk.", required: true },
          reference: { type: "string", description: "Existing DataVolume/PVC name in the namespace, or an OCI containerDisk image reference.", required: true }
        }
        output_format: {
          volume_source: "A KubeVirt VolumeSource (dataVolume or containerDisk) for the temporary VM.",
          owned: "Always false; referenced media is never owned by the build."
        }
        tags: ["datavolume", "containerdisk", "reference", "external-ownership", "read-only"]
      }

      Function("stage_url_media") {
        description: "CONNECTED-CLUSTER option: for a url source (e.g. a cluster-reachable HTTP endpoint such as a Hauler fileserver, or a registry), CDI-import it into a managed DataVolume via the shared staging layer, then reference that DataVolume. Honors the same ownership, retain, retain-on-failure, and identity-guard rules as ISO staging. NOTE: in a locked-down airgap cluster the workstation is not a reachable HTTP source and the cdi-uploadproxy is ClusterIP-only, so the url path is for connected/registry cases; the airgap path is data_volume staged out-of-band by stage-iso."
        metaphor: "Have the depot fetch an outside crate once, keep it in the yard, and lift copies onto the bench each build."
        input_parameters: {
          namespace: { type: "string", description: "Target namespace.", required: true },
          url: { type: "string", description: "Cluster-reachable HTTP(S) or registry source CDI imports.", required: true },
          storage_size: { type: "quantity", description: "Managed media DataVolume capacity (required for url imports).", required: true },
          checksum: { type: "string", description: "Optional CDI checksum (requires CDI 1.65+).", required: false }
        }
        output_format: {
          volume_source: "A dataVolume VolumeSource referencing the imported media.",
          owned: "True when created by this build.",
          volume_uid: "UID recorded for identity-safe cleanup."
        }
        tags: ["cdi", "import", "reuses-staging", "connected-only"]
      }

      Function("attach_media_disk") {
        description: "Append the resolved read-only volume and its disk device (CD-ROM by default, or a data disk) to the temporary VM. The device is never the boot/root disk and is excluded from the captured image; it exists only for the provisioning phase. This is iso_volume_name's CD-ROM attach, generalized to N additional read-only disks."
        metaphor: "Set the pallet on the bench, brakes locked, read-only tag facing out."
        input_parameters: {
          volume_source: { type: "object", description: "Resolved dataVolume or containerDisk source.", required: true },
          attachment: { type: "object", description: "Mode (cdrom|disk), disk name/serial, and bus.", required: true }
        }
        output_format: {
          vm_media: "A (volume, disk) pair added to the temporary VM spec."
        }
        tags: ["kubevirt", "cdrom", "read-only", "reuses-resources", "both-builders"]
      }

      Function("cleanup_managed_media") {
        description: "Delete a plugin-managed (url-imported) media DataVolume only when the build succeeded, the media is not retained, its identity still matches, and the VM has detached. Referenced data_volume and container_disk media are NEVER deleted. Mirrors ISO staging: a failed/cancelled build retains managed media for reuse."
        metaphor: "On a clean job, send the depot's crates back; on a scrubbed job, leave them staged for next time; never ship out the pipeline's own."
        input_parameters: {
          namespace: { type: "string", description: "Namespace.", required: true },
          managed_media: { type: "array", description: "Ownership, retain, and UID of each plugin-managed (url-imported) medium.", required: true },
          build_succeeded: { type: "bool", description: "Whether the build completed cleanly.", required: true }
        }
        output_format: {
          deleted: "Which plugin-managed media were removed."
        }
        tags: ["cleanup", "reuses-staging", "retain-on-failure", "safe-delete"]
      }
    }

    Sprout {
      Chain("ReferenceMediaFlow") {
        description: "AIRGAP-PRIMARY. Attach media that already lives in the cluster: reference an existing DataVolume (staged out-of-band by `harvester-image stage-iso`) or an OCI containerDisk, and mount it read-only. Nothing is streamed from the Packer host or through the guest."
        metaphor: "Lift a pre-crated pallet from the yard straight onto the bench."
        links: [
          { source: "/attach_extra_media", target: "validate_media_source" },
          { source: "validate_media_source", target: "resolve_reference_media" },
          { source: "resolve_reference_media", target: "attach_media_disk" }
        ]
        tags: ["primary", "datavolume", "containerdisk", "reference", "airgap", "linear"]
      }

      Chain("ImportMediaFlow") {
        description: "CONNECTED-CLUSTER option. Attach media from a cluster-reachable url: CDI imports it into a managed DataVolume via the shared staging layer, then mounts it read-only."
        metaphor: "Have the depot fetch and crate an outside item once, then lift it onto the bench."
        links: [
          { source: "/attach_extra_media", target: "validate_media_source" },
          { source: "validate_media_source", target: "stage_url_media" },
          { source: "stage_url_media", target: "attach_media_disk" }
        ]
        tags: ["cdi", "import", "reuses-staging", "connected-only", "linear"]
      }

      Chain("MediaCleanupFlow") {
        description: "Reverse-order teardown: the temporary VM's deletion detaches the media; then release only plugin-managed url-imports per retention policy. Referenced data_volume / container_disk media are preserved."
        metaphor: "Clear the bench, return the depot's crates, leave the pipeline's pallets in the yard."
        links: [
          { source: "/release_extra_media", target: "cleanup_managed_media" }
        ]
        tags: ["cleanup", "reverse-order"]
      }
    }

    Kernels {
      Kernel("ExtraMediaKernel") {
        description: "Governs attaching build-time-only media to the temporary VM entirely within cluster-native primitives: reference an existing DataVolume (airgap-primary) or an OCI containerDisk, or (connected) CDI-import a url — always attached read-only, never part of the captured image, and always opaque to the plugin. Assembling the payload and pushing it into the cluster are OUT OF SCOPE (vdi-factory MediaStaging + HarvesterImageStageISO)."
        metaphor: "The dock foreman's rules: crates arrive pre-packed and pre-hauled, ride the crane not the stairs, sit read-only beside the bench, and only crates the crane itself imported go back."
        directive_chains: ["ReferenceMediaFlow", "ImportMediaFlow", "MediaCleanupFlow"]
        invariants: [
          "The plugin is guest-agnostic: it attaches a read-only volume and never reads, mounts, bundles, or interprets the payload (no Cloudbase-Init/Sysprep/cloud-init/ISO-assembly knowledge in plugin code).",
          "Extra media is attached only to the temporary build VM and is never captured into the golden image; it is build-time scaffolding.",
          "All media is attached read-only.",
          "KubeVirt attaches only in-cluster disks: media reaches the VM as an existing DataVolume (referenced), an OCI containerDisk (pulled cluster-side), or a CDI-imported DataVolume (connected url) — never streamed into the guest over WinRM/SSH and never assembled by the plugin.",
          "AIRGAP-PRIMARY is data_volume: the pipeline stages the ISO into the cluster out-of-band (vdi-factory assembles it, `harvester-image stage-iso` pushes it via resumable dd-over-exec onto a blank Block DataVolume), and the plugin merely attaches that DataVolume by name — the same contract as iso_volume_name.",
          "ConfigMap/Secret and cloudInit/Sysprep volumes remain for small (<1MB) configuration only; extra media is the lane for large payloads.",
          "Referenced media (data_volume, container_disk) is never owned, mutated, or deleted by the build; only plugin-imported (url) media follows staging ownership, identity-guard, retain, and retain-on-failure rules.",
          "The mechanism is shared by both builders (kubevirt-iso and kubevirt-image) and reuses the existing CD-ROM DataVolume attach.",
          "Declaring WHAT files go on the media, assembling the ISO, and staging it into the cluster are the pipeline's job (vdi-factory MediaStaging + harvester-image-tools), not the plugin's.",
          "A referenced data_volume must be BUILDER-READY before attach: content-verified and RWO-free (stage tap detached). Never trust DataVolume.status.phase == Succeeded as proof the media is present — a blank Block DV is Succeeded once bound, before bytes are written.",
          "extra_media is a VERSIONED feature: consumers pin a packer-plugin-kubevirt revision whose named builders (kubevirt-iso, kubevirt-image) implement it, and declare the extra_media block explicitly."
        ]
        tags: ["governor", "cdi-native", "read-only", "ownership", "guest-agnostic"]
      }
    }
  }

  Semantics {
    recommended_transport: |
      data_volume (an existing CDI DataVolume) is the airgap-primary and the first thing to
      implement:
        - It is exactly iso_volume_name generalized to N additional read-only CD-ROMs, so it
          reuses proven attach code and the already-validated stage-iso -> DataVolume -> CDROM
          path.
        - The cluster already holds the bytes (the pipeline staged them), so nothing streams
          from the Packer host or through the guest.
      container_disk (OCI) is the connected/registry variant (and shares the VM-image
      containerDisk contract); url (CDI import) is for connected clusters with a reachable
      HTTP source (e.g. a Hauler fileserver). Neither is required for the airgap-first path.

    configuration_contract: |
      New optional config on BOTH builders: extra_media, a list. Each entry sets exactly one
      source kind and optional attachment options:
        data_volume    : name of an existing DataVolume/PVC in the namespace (AIRGAP-PRIMARY)
        container_disk : OCI containerDisk image reference (connected/registry)
        url            : cluster-reachable HTTP(S) source CDI imports (+ storage_size, optional checksum) (connected)
      Attachment options (all optional):
        as   : "cdrom" (default) or "disk"
        name : disk name/serial (defaults to a generated, collision-checked name)
        bus  : "sata" | "scsi" | "virtio" (sensible default per as/os)

    reuse_map: |
      Reuses today's plumbing:
        - resources volume/disk build -> attach_media_disk (append read-only volumes + disks)
        - iso_volume_name CD-ROM attach -> the data_volume path, generalized to N disks
        - containerDisk pattern       -> resolve_reference_media (already used for virtio drivers)
        - staging.Manager             -> stage_url_media (connected url import + retain-on-failure)
        - StepStopVirtualMachine / VM cleanup detaches media implicitly on VM deletion
      Net-new in the plugin: extra_media validation/resolution and the read-only multi-disk attach.

    boundary: |
      The plugin ONLY attaches media that already exists in the cluster. Reading the media
      declaration, assembling the ISO, content-addressing it, and pushing it into the cluster
      (via `harvester-image stage-iso`) are handled upstream:
        - vdi_factory MediaStaging: reads a Packer-native HCL media var-file (.pkrvars.hcl, via
          python-hcl2) referenced from lineage, assembles a canonical ISO, keys a content-addressed
          DataVolume on the ISO bytes, and calls stage-iso (whose SHA-512 gate is authoritative);
          then passes the DataVolume name to the build as extra_media_volume_name.
        - HarvesterImageStageISO (harvester-image-tools): the resumable dd-over-exec transport
          that lands the ISO as a blank Block CDI DataVolume.
      This mirrors how seal scripts stay in the template for shutdown_command: guest- and
      pipeline-specific concerns stay out of the plugin.

    related_specs: |
      - vdi_factory/specs/media_staging.smdl (MediaStaging): the pipeline side — media var-file,
        lineage `media` pointer, ISO assembly, content-addressed DV name, stage-iso orchestration,
        and change-detection. This is the chunk that produces the data_volume this plugin attaches.
      - harvester-image-tools HarvesterImageStageISO: the airgap dd-over-exec transport reused to
        stage the ISO as a DataVolume.
      - packer-plugin-kubevirt kubevirt-iso iso_volume_name: the existing single-CDROM attach this
        feature generalizes.
      - SUPERSEDES vdi_factory harvester_packer_iso_source.smdl: that older design put ISO
        import/upload in the builder; staging now belongs to stage-iso and the plugin only attaches.

    out_of_scope: |
      - Bundling files / assembling an ISO in the plugin (that is vdi-factory MediaStaging).
      - Pushing bytes from the workstation into the cluster (that is harvester-image stage-iso).
      - cd_files-in-the-template handled by the plugin; the file list lives in a media var-file
        the pipeline owns, not in plugin code.
      - Writable or persistent media; extra media is read-only, build-time-only, and never captured.
      - Interpreting or installing the payload; that is the provisioner's/guest's job.

    open_questions: |
      - Default attachment device: cdrom vs disk. cdrom + iso9660 gives Windows a predictable
        drive letter and read-only semantics; a data disk may need in-guest mount. Leaning cdrom.
      - Should data_volume optionally accept a namespace override (media staged in a shared images
        namespace) or always resolve in the build namespace? Leaning build namespace, like the root disk.
      - containerDisk attach: expose imagePullSecret + imagePullPolicy passthrough now, or defer
        until the OCI/VM-image path needs it.
      - RESOLVED (media-staging review): preflight a referenced data_volume as builder-ready
        (content-verified, Block/expected size, RWO tap detached) and fail fast before VM create;
        never trust DataVolume phase alone.
  }
}
