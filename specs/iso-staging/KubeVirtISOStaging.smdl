Seedscript module description language 2.3

Module("KubeVirtISOStaging") {
  description: "Defines how the kubevirt-iso builder resolves installation media into one CDI DataVolume the temporary VM attaches as its CD-ROM. Two sources are supported: an existing user-managed DataVolume referenced by name, and an HTTP(S) URL that CDI imports inside the cluster. CDI performs all data movement; the plugin only creates, validates, waits on, and cleans up DataVolume objects. Staging a local file into the cluster is intentionally out of scope and left to an external tool that produces a DataVolume the builder then consumes by name."
  metaphor: "A guarded loading dock routes each shipment through the correct bay and releases only identified media to the builder, never touching cargo it did not bring in."
  version: "0.2.0"
  tags: ["packer", "kubevirt", "cdi", "iso", "staging", "lifecycle"]
  theme: {
    visual_style: "guarded-loading-dock",
    color_palette: ["#0C2461", "#1E3799", "#4A69BD", "#82CCDD"],
    metaphorical_language: "source manifests, guarded bays, custody markers, verified hand-off"
  }

  components: {
    Roots {
      Directive("/resolve_iso_source") {
        description: "Resolve exactly one configured ISO source into a DataVolume name that is safe for the temporary VM to attach as its CD-ROM."
        metaphor: "The dockmaster reads one manifest, chooses one bay, and refuses ambiguous cargo."
        parameters: {
          namespace: { type: "string", description: "Namespace containing or receiving the ISO DataVolume.", required: true },
          existing_volume_name: { type: "string", description: "Pre-existing user-owned DataVolume name.", required: false },
          http_url: { type: "string", description: "HTTP or HTTPS URL reachable by CDI importer pods.", required: false },
          staging_name: { type: "string", description: "Name for the managed DataVolume created for http_url; defaults to <name>-iso.", required: false },
          storage_size: { type: "quantity", description: "Destination capacity; required for HTTP imports.", required: false },
          storage_class: { type: "string", description: "Optional destination StorageClass.", required: false },
          checksum: { type: "string", description: "Optional expected source checksum, validated by CDI.", required: false },
          retain: { type: "bool", description: "Whether a plugin-created DataVolume remains after the build.", required: false, default: false }
        }
        actions: {
          validate: "Reject zero or multiple source selectors and source-incompatible options.",
          stage: "Dispatch to the existing-DataVolume or CDI HTTP adapter.",
          hand_off: "Store the resolved DataVolume name and ownership metadata in multistep state."
        }
        kernel: "ISOStagingKernel"
        tags: ["entry", "exclusive-source", "state-handoff"]
      }

      Directive("/release_iso_source") {
        description: "Delete plugin-owned, non-retained media after VM cleanup while preserving externally owned or explicitly retained DataVolumes."
        metaphor: "The dockmaster clears rented bays but never removes customer-owned or bonded cargo."
        parameters: {
          namespace: { type: "string", description: "Staging namespace.", required: true },
          volume_name: { type: "string", description: "Resolved ISO DataVolume name.", required: true },
          owned: { type: "bool", description: "Whether the plugin created the DataVolume.", required: true },
          retain: { type: "bool", description: "Whether the managed DataVolume is a retained cache entry.", required: true }
        }
        actions: {
          clean: "Delete only plugin-owned, non-retained media once VM consumers are gone."
        }
        kernel: "ISOStagingKernel"
        tags: ["cleanup", "ownership-boundary"]
      }
    }

    Bloom {
      Function("validate_source_selection") {
        description: "Validate source cardinality, URL scheme, size, name collisions, and option compatibility before creating cluster resources."
        metaphor: "A manifest inspector permits exactly one declared origin."
        input_parameters: {
          existing_volume_name: { type: "string", description: "Existing source selector.", required: false },
          http_url: { type: "string", description: "HTTP source selector.", required: false },
          storage_size: { type: "quantity", description: "Requested destination size.", required: false }
        }
        output_format: {
          source_kind: "One of existing or http.",
          normalized_options: "Validated, defaulted source-specific options."
        }
        tags: ["pure", "validation", "fail-fast"]
      }

      Function("resolve_existing_datavolume") {
        description: "Fetch a user-owned DataVolume and wait until CDI reports it usable without ever adopting ownership."
        metaphor: "Customer cargo is inspected in place and its custody tag remains untouched."
        input_parameters: {
          namespace: { type: "string", description: "DataVolume namespace.", required: true },
          volume_name: { type: "string", description: "Existing DataVolume name.", required: true }
        }
        output_format: {
          volume_name: "Validated DataVolume name.",
          owned: "Always false."
        }
        tags: ["cdi", "read-only", "external-ownership"]
      }

      Function("stage_http_datavolume") {
        description: "Create a plugin-owned CDI DataVolume whose HTTP source is fetched inside the cluster, recording immutable source identity, and detect an API server that prunes the requested source fields."
        metaphor: "The remote shipment is pulled directly into a rented guarded bay, and the bay is rejected if its seal was altered on the way in."
        input_parameters: {
          namespace: { type: "string", description: "Target namespace.", required: true },
          url: { type: "string", description: "Cluster-reachable HTTP or HTTPS URL.", required: true },
          volume_name: { type: "string", description: "Managed DataVolume name.", required: true },
          storage_size: { type: "quantity", description: "Requested destination capacity.", required: true },
          storage_class: { type: "string", description: "Optional StorageClass.", required: false },
          checksum: { type: "string", description: "Optional CDI HTTP checksum (requires CDI 1.65+).", required: false }
        }
        output_format: {
          volume_name: "Created or safely reused DataVolume name.",
          volume_uid: "UID of the object this build created or adopted.",
          owned: "True when created by this plugin configuration.",
          source_identity: "URL hash and checksum recorded on the object."
        }
        tags: ["cdi", "http-import", "cluster-pull", "idempotent"]
      }

      Function("wait_for_datavolume") {
        description: "Wait for CDI success while terminating immediately on Failed and surfacing phase, progress, and condition messages."
        metaphor: "A bay monitor reports movement and raises an alarm instead of waiting silently on failed cargo."
        input_parameters: {
          namespace: { type: "string", description: "DataVolume namespace.", required: true },
          volume_name: { type: "string", description: "DataVolume name.", required: true },
          timeout: { type: "duration", description: "Maximum wait duration.", required: true }
        }
        output_format: {
          phase: "Succeeded or a terminal error.",
          progress: "Latest CDI progress value."
        }
        tags: ["poll", "terminal-state", "diagnostics"]
      }

      Function("validate_managed_source_identity") {
        description: "Permit reuse of an existing managed DataVolume only when ownership, source kind, source identity, and storage shape match the request; fail closed otherwise."
        metaphor: "A retained bay is reopened only when every seal matches its manifest."
        input_parameters: {
          requested_identity: { type: "SourceIdentity", description: "Current source identity.", required: true },
          datavolume: { type: "DataVolume", description: "Existing DataVolume object.", required: true }
        }
        output_format: {
          reusable: "Whether the existing managed source can be reused.",
          reason: "Mismatch explanation."
        }
        tags: ["cache", "identity", "fail-closed"]
      }

      Function("publish_iso_volume") {
        description: "Publish the resolved name, UID, ownership, retention, and source identity into multistep state for VM creation and reverse-order cleanup."
        metaphor: "The dockmaster issues a custody receipt consumed by the VM assembly line."
        input_parameters: {
          volume_name: { type: "string", description: "Resolved DataVolume name.", required: true },
          volume_uid: { type: "string", description: "Resolved DataVolume UID (managed sources only).", required: false },
          owned: { type: "bool", description: "Plugin ownership marker.", required: true },
          retain: { type: "bool", description: "Retention decision.", required: true },
          source_identity: { type: "SourceIdentity", description: "Resolved source identity.", required: true }
        }
        output_format: {
          state: "Resolved volume name, UID, source identity, ownership, and retention keys."
        }
        tags: ["multistep", "handoff"]
      }

      Function("cleanup_owned_source") {
        description: "Delete a managed DataVolume only after verifying it is still the exact object this build created; preserve external and retained media on every path."
        metaphor: "Only an empty rented bay with a matching seal is swept; customer and bonded bays remain sealed."
        input_parameters: {
          namespace: { type: "string", description: "DataVolume namespace.", required: true },
          volume_name: { type: "string", description: "Resolved DataVolume name.", required: true },
          volume_uid: { type: "string", description: "Expected DataVolume UID.", required: false },
          owned: { type: "bool", description: "Plugin ownership marker.", required: true },
          retain: { type: "bool", description: "Retention decision.", required: true }
        }
        output_format: {
          deleted: "Whether a plugin-owned DataVolume was removed."
        }
        tags: ["cleanup", "safe-delete", "idempotent"]
      }
    }

    Sprout {
      Chain("ExistingDataVolumeFlow") {
        description: "Validate and hand off an existing user-managed installation-media DataVolume."
        metaphor: "Customer cargo moves through inspection without changing custody."
        links: [
          { source: "/resolve_iso_source", target: "validate_source_selection" },
          { source: "validate_source_selection", target: "resolve_existing_datavolume" },
          { source: "resolve_existing_datavolume", target: "wait_for_datavolume" },
          { source: "wait_for_datavolume", target: "publish_iso_volume" }
        ]
        tags: ["existing", "linear"]
      }

      Chain("HTTPImportFlow") {
        description: "Create or safely reuse a managed CDI HTTP import and hand it to the builder after CDI success."
        metaphor: "Remote cargo is pulled, identity-checked, monitored, and receipted."
        links: [
          { source: "/resolve_iso_source", target: "validate_source_selection" },
          { source: "validate_source_selection", target: "stage_http_datavolume" },
          { source: "stage_http_datavolume", target: "validate_managed_source_identity" },
          { source: "validate_managed_source_identity", target: "wait_for_datavolume" },
          { source: "wait_for_datavolume", target: "publish_iso_volume" }
        ]
        tags: ["http", "cdi", "linear"]
      }

      Chain("SourceCleanupFlow") {
        description: "Apply source ownership and retention policy after reverse-order VM cleanup."
        metaphor: "The receipt controls which empty bay may be cleared."
        links: [
          { source: "/release_iso_source", target: "cleanup_owned_source" }
        ]
        tags: ["cleanup", "reverse-order"]
      }
    }

    Kernels {
      Kernel("ISOStagingKernel") {
        description: "Governs source exclusivity, CDI-backed staging, verified hand-off, and ownership-safe cleanup for installation media."
        metaphor: "The dock authority permits one manifest, one custody chain, and one verified hand-off."
        directive_chains: ["ExistingDataVolumeFlow", "HTTPImportFlow", "SourceCleanupFlow"]
        invariants: [
          "Exactly one of existing_volume_name or http_url is configured.",
          "The resolved ISO DataVolume name never collides with the output DataVolume or temporary root disk.",
          "A URL is handed to CDI for an in-cluster pull; it is never downloaded into the Packer cache where the cluster cannot reach it.",
          "CDI performs all data movement; the plugin never streams image bytes itself.",
          "An existing DataVolume is always externally owned and is never deleted by plugin cleanup.",
          "A managed DataVolume is reused only when its immutable source identity and storage shape match; a pruned or mismatched object fails closed and is never treated as a cache entry.",
          "VM creation reads the resolved DataVolume name from multistep state rather than assuming configuration contains a pre-existing name.",
          "Plugin-owned non-retained media is deleted only after the temporary VM is confirmed detached, and only when the object's UID and identity still match this build.",
          "A halted or cancelled build retains the managed import so a re-run reuses it; deletion happens only on a clean build (or when explicitly forced).",
          "Retention and ownership are explicit state, not inferred from object existence during cleanup."
        ]
        tags: ["governor", "ownership", "integrity", "lifecycle"]
      }
    }
  }

  Semantics {
    configuration_contract: |
      iso_volume_name selects an existing, externally owned DataVolume (unchanged, backwards compatible).
      iso_url selects a managed CDI HTTP import. Managed-source options (iso_staging_name,
      iso_storage_size, iso_storage_class, iso_checksum, iso_retain, iso_http_secret_ref,
      iso_http_cert_config_map, iso_staging_timeout) apply only with iso_url.

    out_of_scope: |
      Uploading a local ISO from the Packer host into the cluster is deliberately NOT handled here.
      The CDI primitive is about the cluster fetching media; pushing local bytes through the API is a
      separate transport concern. Stage local media beforehand (e.g. virtctl image-upload or a
      dedicated tool) and reference the resulting DataVolume via iso_volume_name. A future revision may
      revisit in-plugin local staging once the URL path has proven out.

    cache_policy: |
      A managed DataVolume is deleted after the build unless iso_retain is true. A retained DataVolume
      forms a namespace-scoped cache and must pass exact identity validation (source URL hash, checksum,
      size, storage class) before reuse.
  }
}
